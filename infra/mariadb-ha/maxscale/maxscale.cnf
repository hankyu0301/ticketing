[maxscale]
threads=auto
admin_host=0.0.0.0
admin_port=8989
admin_secure_gui=false
substitute_variables=true

[mariadb-primary]
type=server
address=mariadb-primary
port=3306
protocol=MariaDBBackend

[mariadb-replica-1]
type=server
address=mariadb-replica-1
port=3306
protocol=MariaDBBackend

[mariadb-replica-2]
type=server
address=mariadb-replica-2
port=3306
protocol=MariaDBBackend

[MariaDB-Monitor]
type=monitor
module=mariadbmon
servers=mariadb-primary,mariadb-replica-1,mariadb-replica-2
user=$MAXSCALE_MONITOR_USER
password=$MAXSCALE_MONITOR_PASSWORD
monitor_interval=2s
failcount=3
auto_failover=true
auto_rejoin=true
cooperative_monitoring_locks=majority_of_all
enforce_read_only_slaves=true
enforce_writable_master=true
journal_max_age=2592000s
replication_user=$MARIADB_REPLICATION_USER
replication_password=$MARIADB_REPLICATION_PASSWORD

[Primary-Service]
type=service
router=readconnroute
servers=mariadb-primary,mariadb-replica-1,mariadb-replica-2
user=$MAXSCALE_SERVICE_USER
password=$MAXSCALE_SERVICE_PASSWORD
router_options=master

[Primary-Listener]
type=listener
service=Primary-Service
protocol=MariaDBClient
address=0.0.0.0
port=4006
