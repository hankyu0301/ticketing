<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ticketing.domain.lock.mapper.NamedLockMapper">

    <select id="getLock" resultType="java.lang.Integer">
        SELECT GET_LOCK(#{lockName}, #{timeoutSeconds})
    </select>

    <select id="releaseLock" resultType="java.lang.Integer">
        SELECT RELEASE_LOCK(#{lockName})
    </select>

</mapper>